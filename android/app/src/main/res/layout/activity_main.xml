<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="84dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/local_only"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            layout="@layout/screen_share" />

        <include
            layout="@layout/screen_cast"
            android:visibility="gone" />

        <include
            layout="@layout/screen_inbox"
            android:visibility="gone" />

        <include
            layout="@layout/screen_activity"
            android:visibility="gone" />
    </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/floating_bottom_navigation"
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_bar"
        android:baselineAligned="false"
        android:elevation="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:outlineProvider="background"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:translationZ="10dp">

        <LinearLayout
            android:id="@+id/nav_share"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/share"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_share"
                android:tint="@color/nav_item_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/share"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_cast"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/cast"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_cast"
                android:tint="@color/nav_item_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/cast"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/nav_inbox"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/inbox"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_inbox"
                    android:tint="@color/nav_item_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/inbox"
                    android:textColor="@color/nav_item_color"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/inbox_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginTop="-2dp"
                android:background="@drawable/bg_unread_badge"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/on_accent"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/nav_activity"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/activity"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_activity"
                android:tint="@color/nav_item_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/activity"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
