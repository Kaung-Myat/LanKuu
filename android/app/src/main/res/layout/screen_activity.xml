<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/TextAppearance.LanKuu.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/activity" />

        <TextView
            style="@style/TextAppearance.LanKuu.BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/activity_description" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_receiver_active"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="15dp">

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/status_text"
                style="@style/TextAppearance.LanKuu.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/ready_trusted_network"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LanKuu.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/recent_activity" />

        <LinearLayout
            android:id="@+id/activity_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/activity_empty"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_nav_activity"
                    android:tint="@color/accent" />

                <TextView
                    style="@style/TextAppearance.LanKuu.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/no_activity_title" />

                <TextView
                    style="@style/TextAppearance.LanKuu.BodyMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/no_activity"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LanKuu.BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/security_note"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
