<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/share_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/TextAppearance.LanKuu.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share" />

        <TextView
            style="@style/TextAppearance.LanKuu.BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/share_description" />

        <TextView
            style="@style/TextAppearance.LanKuu.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/destination" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_device" />

                <TextView
                    android:id="@+id/selected_device"
                    style="@style/TextAppearance.LanKuu.BodyMuted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/no_destination"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/peer_host"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/peer_ip_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/discover_devices"
                    style="@style/Widget.LanKuu.SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="96dp"
                    android:text="@string/discover_short" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/device_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.LanKuu.BodyMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="@string/discovery_hint"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LanKuu.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/choose_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.LanKuu.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text_message" />

                <TextView
                    android:id="@+id/character_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/character_count_initial"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/message_input"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/text_to_send_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="16384"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/send_text"
                style="@style/Widget.LanKuu.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="11dp"
                android:drawableEnd="@drawable/ic_send"
                android:drawablePadding="8dp"
                android:text="@string/send_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_activity"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_file" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.LanKuu.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/send_a_file" />

                    <TextView
                        style="@style/TextAppearance.LanKuu.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/file_description"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/send_file"
                    style="@style/Widget.LanKuu.SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:minWidth="82dp"
                    android:text="@string/choose_file" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LanKuu.BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/direct_transfer_note"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
